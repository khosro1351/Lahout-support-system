{
  "name": "lahout-support-system",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lahout/backend --filter @lahout/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @lahout/backend db:migrate",
    "db:seed:dev": "pnpm --filter @lahout/backend db:seed:dev",
    "db:seed:access:dev": "pnpm --filter @lahout/backend db:seed:access:dev",
    "start:backend": "pnpm --filter @lahout/backend start",
    "start:frontend": "node --env-file=.env tests/preview.mjs",
    "build:tools": "pnpm --filter @lahout/backend build:tools",
    "test:login": "pnpm build:tools && node --env-file=.env scripts/run-regression.mjs login",
    "test:access": "pnpm build:tools && node --env-file=.env scripts/run-regression.mjs access",
    "test": "pnpm build:tools && node --env-file=.env scripts/run-regression.mjs all",
    "test:install-browser": "playwright install chromium",
    "db:seed:guide:dev": "pnpm --filter @lahout/backend db:seed:guide:dev",
    "test:guide": "pnpm build:tools && node --env-file=.env scripts/run-regression.mjs guide",
    "start:staging": "node scripts/start-staging.mjs",
    "prepare:staging": "node scripts/prepare-staging.mjs",
    "test:staging": "node --env-file=.env tests/staging-runtime.mjs",
    "db:seed:family-read:dev": "pnpm build:tools && node --env-file=.env apps/backend/.tools/scripts/seed-family-read-dev.js",
    "db:seed:roles:dev": "pnpm build:tools && node --env-file=.env apps/backend/.tools/scripts/seed-roles-dev.js",
    "test:roles": "pnpm build:tools && node --env-file=.env scripts/run-regression.mjs roles",
    "db:seed:livelihood:dev": "pnpm build:tools && node --env-file=.env apps/backend/.tools/scripts/seed-livelihood-dev.js",
    "test:livelihood": "pnpm build:tools && node --env-file=.env scripts/run-regression.mjs livelihood",
    "db:seed:livelihood:scenarios:dev": "pnpm db:seed:livelihood:dev && node --env-file=.env apps/backend/.tools/scripts/seed-livelihood-scenarios-dev.js",
    "test:livelihood:seed": "pnpm build:tools && node --env-file=.env scripts/run-regression.mjs livelihoodSeed",
    "test:technical:ui": "pnpm build:tools && node --env-file=.env scripts/run-regression.mjs technicalUi",
    "test:leader:ui": "pnpm build:tools && node --env-file=.env scripts/run-regression.mjs leaderUi"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
