# Optional settings: add selected variables to the existing local .env.
# Do not replace that file. Default storage is ../lahout-persistent-data/uploads
# beside the repository, independent of dist/, source and test data.
# UPLOAD_STORAGE_ROOT=C:/LahoutData/uploads
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_TOTAL_BYTES=52428800
UPLOAD_MAX_FILES=30
UPLOAD_MAX_PDF_PAGES=100
UPLOAD_IMAGE_TARGET_BYTES=512000
UPLOAD_IMAGE_MAX_DIMENSION=2600
UPLOAD_IMAGE_QUALITY=85
UPLOAD_IMAGE_MIN_QUALITY=78
