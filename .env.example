# Copy to .env at the repository root; .env is excluded from Git and archives.
APP_ENV=development
BACKEND_PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://lahout_dev:REPLACE_WITH_YOUR_URL_ENCODED_DB_PASSWORD@127.0.0.1:5432/lahout_dev
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
PREVIEW_PORT=5173
BACKEND_PROXY=http://127.0.0.1:3000

# Optional regression database owner (requires CREATEDB). Blank uses DATABASE_URL.
TEST_DATABASE_ADMIN_URL=
# Optional existing Chrome/Chromium absolute executable path. Blank uses installed Playwright Chromium.
BROWSER_EXECUTABLE=

# DEV_SEED_PASSWORD is supplied by scripts/Seed-Development.ps1 only while seeding.
# Do not add a real development password or session token here.
# Sessions are generated at runtime; this application does not use a static SESSION_SECRET.

# Hosting only: inject these through Render Environment; never commit a populated .env.
# APP_ENV=staging
# PORT is provided by Render; RENDER_EXTERNAL_URL supplies the HTTPS origin.
# VITE_APP_ENV=staging (build-time, non-secret environment label)
# STAGING_SEED_ENABLED=true (turn off after first successful provisioning)
# STAGING_GUIDE_PASSWORD: set a unique value of at least 16 characters in Render secrets.
# Optional STAGING_FIXTURE_PASSWORD: separate secret for synthetic role accounts.
# No password value is supplied here. Database name must contain staging.
